# paperless-cf-ocr settings. Copy to cf-ocr.env (Docker) or add to paperless.conf (native).
# Only the gateway location and a credential are required; everything else has defaults.

# --- Cloudflare AI Gateway -----------------------------------------------------------
# Either the two IDs...
PAPERLESS_CF_OCR_ACCOUNT_ID=
PAPERLESS_CF_OCR_GATEWAY_ID=
# ...or the gateway URL: https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-id>
#PAPERLESS_CF_OCR_GATEWAY_URL=
# If Paperless's own AI settings (PAPERLESS_AI_LLM_ENDPOINT) already point at the same
# gateway's /compat or /workers-ai route, the gateway and API key are reused and the
# lines above can stay empty.

# Cloudflare API token with "Workers AI: Read" and "AI Gateway: Run". With both
# permissions this one token also passes an authenticated gateway (verified).
PAPERLESS_CF_OCR_API_TOKEN=
# Only if you use a separate gateway authentication token (sent as cf-aig-authorization).
#PAPERLESS_CF_OCR_GATEWAY_TOKEN=

# --- Model ------------------------------------------------------------------------------
#PAPERLESS_CF_OCR_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
# Optional second opinion, e.g. Claude Sonnet 5.5 via the gateway (billed by Cloudflare;
# page images are then also processed by Anthropic):
#PAPERLESS_CF_OCR_SECOND_OPINION_MODEL=anthropic/claude-sonnet-5-5
#PAPERLESS_CF_OCR_SECOND_OPINION=low-confidence      # or: always

# --- Behaviour ----------------------------------------------------------------------------
#PAPERLESS_CF_OCR_EXISTING_TEXT=auto     # auto | trust | ignore  (PDFs that already have text)
#PAPERLESS_CF_OCR_ARCHIVE=hybrid         # hybrid | none
#PAPERLESS_CF_OCR_FALLBACK=tesseract     # tesseract | fail
#PAPERLESS_CF_OCR_ENABLED=true
